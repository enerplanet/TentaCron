# Production environment — unified config.
#
# Same variable vocabulary as .env.dev; read by docker compose and interpolated
# into environment/config.yaml. See .env.dev for the full explanation.
#
#   make -C environment run ENV=prod
#
# !! Replace every change-me value before deploying — tentacron starts with
# !! whatever is set here, and these placeholders are not secrets.

# Compose project name (portable replacement for the v2-only `name:` key).
COMPOSE_PROJECT_NAME=tentacron-env

# Port the API listens on (container-internal). Interpolated into addr: ":PORT".
PORT=8080

# Publish on the standard HTTP port; container still listens on PORT. (compose only)
HOST_PORT=80

# Config file the API loads. (compose -> root Makefile run target)
CONFIG=environment/config.yaml

# Image tag for this environment. (compose only)
IMAGE_TAG=tentacron-env:prod

# Client keys accepted by tentacron itself (auth.api_keys).
TENTACRON_KEY_FRONTEND=change-me-frontend
TENTACRON_KEY_BATCH=change-me-batch

# Credentials tentacron presents to downstream services.
MEME_API_KEY=change-me-meme
BUEM_API_KEY=change-me-buem
PV1_API_KEY=change-me-pv1
WIND_API_KEY=change-me-wind

# Credential for the weather resolvent resource API.
WEATHER_API_KEY=change-me-weather

# Credential for the ignis TABULA resource API.
IGNIS_API_KEY=change-me-ignis
