# Development environment — unified config.
#
# One vocabulary shared by BOTH docker compose and the tentacron binary:
#   * docker compose reads: PORT, HOST_PORT, CONFIG, IMAGE_TAG
#   * the config file (environment/config.yaml) interpolates: PORT,
#     TENTACRON_KEY_*, MEME_API_KEY, BUEM_API_KEY, PV1_API_KEY, WIND_API_KEY,
#     WEATHER_API_KEY, IGNIS_API_KEY
#
# Use it either way:
#   make -C environment run ENV=dev
#   set -a && . environment/.env.dev && set +a && make run CONFIG=environment/config.yaml

# Compose project name (portable replacement for the v2-only `name:` key).
COMPOSE_PROJECT_NAME=tentacron-env

# Port the API listens on (container-internal). Interpolated into addr: ":PORT".
PORT=8080

# Host port docker publishes -> container's PORT. (compose only)
HOST_PORT=8080

# Config file the API loads. (compose -> root Makefile run target)
CONFIG=environment/config.yaml

# Image tag for this environment. (compose only)
IMAGE_TAG=tentacron-env:dev

# Published release image for `make run-release` (compose only). Pin a
# version in production, e.g. ghcr.io/enerplanet/tentacron:0.2.0-alpha.
RELEASE_IMAGE=ghcr.io/enerplanet/tentacron:latest

# Client keys accepted by tentacron itself (auth.api_keys). Must be non-empty:
# tentacron refuses to start with missing credentials.
TENTACRON_KEY_FRONTEND=dev-frontend-key
TENTACRON_KEY_BATCH=dev-batch-key

# Credentials tentacron presents to downstream services. Placeholders are fine
# for booting the service in dev; point the config at real upstreams (or
# fakes) before submitting jobs.
MEME_API_KEY=dev-meme-key
BUEM_API_KEY=dev-buem-key
PV1_API_KEY=dev-pv1-key
WIND_API_KEY=dev-wind-key

# Credential for the weather resolvent resource API.
WEATHER_API_KEY=dev-weather-key

# Credential for the ignis TABULA resource API.
IGNIS_API_KEY=dev-ignis-key
