    given-names: "Andreas Willibald"
    affiliation: "BigGeoData & Spatial AI, Technische Hochschule Deggendorf"
repository-code: "https://github.com/enerplanet/tentacron"
url: "https://enerplanet.github.io/tentacron"
license: MIT
version: "0.2.0-alpha"
date-released: "2026-09-06"
